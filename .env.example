# Atlas Note environment example
# Copy this file to .env for local-only settings.
# Do not commit real API keys, passwords, tokens, or personal data.

# AI settings are configured in Atlas Note.
# Never add AI API keys to this file or to a .env file.

# WebDAV sync settings
WEBDAV_ENDPOINT=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# Local storage root. Existing root data becomes the "メイン" storage space;
# additional spaces are managed under this root by Atlas Note.
ATLAS_NOTE_DATA_DIR=
